# ─── Copiar este archivo como .env y completar los valores ───
# cp .env.example .env

# Entorno
NODE_ENV=development

# Base de datos PostgreSQL
DB_NAME=caloria_db
DB_USER=caloria_user
DB_PASSWORD=cambia_esta_password_segura

# JWT
JWT_SECRET=cambia_este_secret_muy_largo_y_aleatorio_minimo_32_chars
JWT_EXPIRES=7d

# Open Food Facts (no necesita API key — es pública)
OFF_BASE_URL=https://world.openfoodfacts.org
OFF_SEARCH_URL=https://world.openfoodfacts.org/cgi/search.pl

# ─── Variables para producción en GCP (no tocar en local) ────
# DOMAIN=caloria.tu-subdominio.com
# SSL_EMAIL=tu@email.com
